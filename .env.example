# Copiar a .env y sustituir TODOS los valores CHANGE_ME antes de arrancar.
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_DB=motorscope
POSTGRES_USER=motorscope
POSTGRES_PASSWORD=CHANGE_ME_USE_A_RANDOM_PASSWORD_OF_AT_LEAST_32_CHARS
DATABASE_URL=postgresql+psycopg://motorscope:CHANGE_ME_USE_A_RANDOM_PASSWORD_OF_AT_LEAST_32_CHARS@postgres:5432/motorscope

REDIS_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_RANDOM_PASSWORD
REDIS_URL=redis://:CHANGE_ME_USE_A_DIFFERENT_RANDOM_PASSWORD@redis:6379/0

CORS_ORIGINS=["http://localhost"]
ALLOWED_HOSTS=["localhost","127.0.0.1","api","web"]
SESSION_COOKIE_NAME=motorscope_session
CSRF_COOKIE_NAME=motorscope_csrf
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=900

# Solo para `python -m app.auth.cli create-owner`; no se guardan en la aplicación.
OWNER_EMAIL=owner@example.invalid
OWNER_PASSWORD=CHANGE_ME_USE_A_UNIQUE_PASSWORD_OF_AT_LEAST_16_CHARS

NEXT_PUBLIC_API_BASE_URL=/api/v1
CADDY_SITE_ADDRESS=http://localhost
