{
  "name": "motorscope",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": "24.20.0",
    "pnpm": "11.1.3"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @motorscope/web dev",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @motorscope/web e2e"
  }
}
